# Heekki settings. Copy to .env and fill in; never commit .env.

# --- Discord ---
DISCORD_TOKEN=

# --- Music: Lavalink and its helpers (docker-compose.yml) ---
# Shared by the bot and the Lavalink container
LAVALINK_PASSWORD=youshallnotpass
# Between Lavalink and the YouTube cipher helper: any long random string (required by docker compose)
YT_CIPHER_PASSWORD=
# Lavalink's YouTube sign-in with a spare Google account (README step 5)
YOUTUBE_REFRESH_TOKEN=
# Optional: Spotify links and search (https://developer.spotify.com/dashboard)
SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional: only if Lavalink isn't on localhost:2333
# LAVALINK_HOST=localhost
# LAVALINK_PORT=2333

# --- Last.fm (optional: fm, fmtop, whoknows, collage). Free key: https://www.last.fm/api/account/create ---
LASTFM_API_KEY=

# --- Neon: filled in by `neon deploy` / `neon env pull` ---
# Postgres (settings, Last.fm links, crowns, coins)
DATABASE_URL=
# Object Storage (greeting backgrounds)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
